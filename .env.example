APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# SQLite defaults to instance/ramosolo.db for synthetic local development.
# Supabase: use your PostgreSQL session-pooler URL, URL-encode password characters.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# APP_ENV=production
# DB_SCHEMA=ramosolo
# APP_TRUSTED_HOSTS=portal.example.test
# AUTH_PUBLIC_URL=https://portal.example.test
# APP_TRUSTED_PROXY_HOPS=0
# Set explicitly when more than one medical institution is provisioned.
# PUBLIC_INSTITUTION_ID=1
# Optional JSON object keyed by an exact enquiry category. Each offer requires
# currency (ZAR), fee and deposit as two-decimal strings, and approved
# cancellation, no_show and refund text. Requires PUBLIC_INSTITUTION_ID.
# BOOKING_TERMS_JSON=
# Leave the approval digest unset until the practice approves the exact text and institution.
# BOOKING_TERMS_APPROVED_SHA256=
